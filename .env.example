# MongoDB Connection
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/hrm-system
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hrm-system

# Server Configuration
PORT=5000
NODE_ENV=development

# Session Secret
# Generate a secure secret using: npm run generate-secret
# For development, you can use: dev_secret_change_in_production
# For production, use a randomly generated 128+ character string
SESSION_SECRET=dev_secret_change_in_production
