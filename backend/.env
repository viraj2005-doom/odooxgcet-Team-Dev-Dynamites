# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/dayflow_hrms

# JWT Configuration
JWT_SECRET=dayflow_hrms_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
# For Gmail: Enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
# Replace with your actual Gmail and App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_actual_email@gmail.com
SMTP_PASS=your_16_character_app_password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Skip email verification in development (set to true to bypass email)
SKIP_EMAIL_VERIFICATION=false
